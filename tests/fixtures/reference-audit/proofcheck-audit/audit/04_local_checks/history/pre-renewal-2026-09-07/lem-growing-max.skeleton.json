   "line": 13,
   "sha256": "876233b8a03f24d0857a26d052957e71a7978dbe28514f9de6cd46217ef0121b",
   "text": "\\begin{proof}"
  },
  {
   "line": 14,
   "sha256": "046e28d55a1c84283458d08cabe2d9047bb99de99ce4dc2d98ee8ddaa6345f5f",
   "text": "Fix $\\varepsilon > 0$."
  },
  {
   "line": 15,
   "sha256": "e86bfca9b219a254e0ba1d5a62784311d71227d65204e8de0fcf3ba94f10d924",
   "text": "For each fixed $j$, $P(|X_{n,j}| > \\varepsilon) \\to 0$ by hypothesis."
  },
  {
   "line": 16,
   "sha256": "43301734c3287ad3dcc9acdd6958f3841212f749309e8766d1f554366eca81d9",
   "text": "Therefore $P(\\max_{1 \\le j \\le m_n} |X_{n,j}| > \\varepsilon) \\to 0$."
  },
  {
   "line": 17,
   "sha256": "cc827c1dd1fa3b27e8f6f08ec1c854dd9d2030d5466bb41881c334d5647dc741",
   "text": "Hence the maximum converges to zero in probability."
  },
  {
   "line": 18,
   "sha256": "923e6f2ceee70dab30fb38391d0660b7e80b6c7e8d2669b45bbc7fd4cb93aaa4",
   "text": "\\end{proof}"
  }
 ],

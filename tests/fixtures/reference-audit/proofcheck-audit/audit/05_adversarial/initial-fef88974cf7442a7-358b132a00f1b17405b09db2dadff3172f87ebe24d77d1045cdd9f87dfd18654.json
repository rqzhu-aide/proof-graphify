        "span_sha256": "863987af71ffccd32299f3a95efb0563027ff63d1abc8177451d3de19caf136a",
        "lines": [
          {
            "line": 6,
            "text": "\\begin{lemma}\\label{lem:growing-max}"
          },
          {
            "line": 7,
            "text": "Let $\\{X_{n,j} : 1 \\le j \\le m_n\\}$ be random variables on one probability"
          },
          {
            "line": 8,
            "text": "space such that $X_{n,j} \\to 0$ in probability as $n \\to \\infty$ for each"
          },
          {
            "line": 9,
            "text": "fixed $j$, and let $m_n \\to \\infty$. Then"
          },
          {
            "line": 10,
            "text": "$\\max_{1 \\le j \\le m_n} |X_{n,j}| \\to 0$ in probability."
          },
          {
            "line": 11,
            "text": "\\end{lemma}"
          }
        ]
      },
      "proof": {
        "source_member": {
          "index": 1,
          "name": "paper.tex",
          "audit_relative_file": "audit/00_sources/project/paper.tex",
          "file_sha256": "aacbf71efe27f4decd4a85208223e763e54a585b4b074a1b3a0029eaff54875f"
        },
        "start_line": 13,
        "end_line": 18,
        "span_sha256": "a1c45ce017bdfe3b1691725e77c10f91c5ebab0999c7679b23f079046cad0eec",
        "lines": [
          {
            "line": 13,
            "text": "\\begin{proof}"
          },
          {
            "line": 14,
            "text": "Fix $\\varepsilon > 0$."
          },
          {
            "line": 15,
            "text": "For each fixed $j$, $P(|X_{n,j}| > \\varepsilon) \\to 0$ by hypothesis."
          },
          {
            "line": 16,
            "text": "Therefore $P(\\max_{1 \\le j \\le m_n} |X_{n,j}| > \\varepsilon) \\to 0$."
          },
          {
            "line": 17,
            "text": "Hence the maximum converges to zero in probability."
          },
          {
            "line": 18,
            "text": "\\end{proof}"
          }
        ]
      }
    },

        "start_line": 20,
        "end_line": 24,
        "span_sha256": "40e3e3d37f8f13e9b4182e2934e13babfe05135f87a2b67dc8d66f18659985a6",
        "lines": [
          {
            "line": 20,
            "text": "\\begin{theorem}\\label{thm:main}"
          },
          {
            "line": 21,
            "text": "Under the conditions of Lemma~\\ref{lem:growing-max}, with"
          },
          {
            "line": 22,
            "text": "$\\hat\\theta_n = \\theta_0 + \\max_{1 \\le j \\le m_n} |X_{n,j}|$,"
          },
          {
            "line": 23,
            "text": "the estimator satisfies $\\hat\\theta_n \\to \\theta_0$ in probability."
          },
          {
            "line": 24,
            "text": "\\end{theorem}"
          }
        ]
      },
      "proof": {
        "source_member": {
          "index": 1,
          "name": "paper.tex",
          "audit_relative_file": "audit/00_sources/project/paper.tex",
          "file_sha256": "aacbf71efe27f4decd4a85208223e763e54a585b4b074a1b3a0029eaff54875f"
        },
        "start_line": 26,
        "end_line": 30,
        "span_sha256": "5308916e39da1b6e4cc0d2dae699c8cbb2d6db1e31fb03774b9611bb24553b28",
        "lines": [
          {
            "line": 26,
            "text": "\\begin{proof}"
          },
          {
            "line": 27,
            "text": "By Lemma~\\ref{lem:growing-max},"
          },
          {
            "line": 28,
            "text": "$\\max_{1 \\le j \\le m_n} |X_{n,j}| \\to 0$ in probability."
          },
          {
            "line": 29,
            "text": "Hence $\\hat\\theta_n - \\theta_0 \\to 0$ in probability, which is the claim."
          },
          {
            "line": 30,
            "text": "\\end{proof}"
          }
        ]
      }
    },
    "obligation_sha256": "bb533147795044a6aba2a50b0089a9c297c2b7d6a6b3436e89e85fd4a9e8ba9b",

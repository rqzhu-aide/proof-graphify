        "end_line": 3,
        "sha256": "2e4c70b4297ea318d08510e245bc03f7cd327c5c51272a2aa5490452ff448be8"
      },
      "proof_required": true,
      "label": "thm:main",
      "statement": {
        "file": "paper.tex",
        "start_line": 20,
        "end_line": 24
      },
      "statement_excerpt": "\\begin{theorem}\\label{thm:main} Under the conditions of Lemma~\\ref{lem:growing-max}, with $\\hat\\theta_n = \\theta_0 + \\max_{1 \\le j \\le m_n} |X_{n,j}|$, the estimator satisfies $\\hat\\theta_n \\to \\theta_0$ in probability. \\end{theorem}",
      "proof": {

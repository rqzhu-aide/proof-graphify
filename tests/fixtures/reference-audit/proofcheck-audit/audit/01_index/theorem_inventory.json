      "proof_required": true,
      "label": "lem:growing-max",
      "statement": {
        "file": "paper.tex",
        "start_line": 6,
        "end_line": 11
      },
      "statement_excerpt": "\\begin{lemma}\\label{lem:growing-max} Let $\\{X_{n,j} : 1 \\le j \\le m_n\\}$ be random variables on one probability space such that $X_{n,j} \\to 0$ in probability as $n \\to \\infty$ for each fixed $j$, and let $m_n \\to \\infty$. Then $\\max_{1 \\le j \\le m_n} |X_{n,j}| \\to 0$ in probability. \\end{lemma}",
      "proof": {
        "file": "paper.tex",
        "start_line": 13,
        "end_line": 18
      },
      "proof_redirects": [],
